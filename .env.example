# URL do webservice XML que fornece o status dos agentes.
# O token faz parte da query string; substitua pelo token real do ambiente.
API_URI="http://HOST:PORTA/webservice/status_agente_system/type=/?token=SEU_TOKEN_AQUI"

# URI de conexão AMQP com o RabbitMQ.
# Formato: amqp://usuario:senha@host:porta/vhost (vhost padrão é %2F, ou seja, "/")
RABBITMQ_URI="amqp://admin:SENHA_AQUI@rabbitmq:5672/%2F"

# Nomes das filas usadas no RabbitMQ (equivalentes aos antigos tópicos do Kafka)
QUEUE_STATUS_AGENT="status_agent"
QUEUE_API="api_status_agent"

# URI de conexão com o MongoDB
MONGO_URI="mongodb://root:SENHA_AQUI@mongo"
DB_CLIENT="status_agent"

# Timeouts (em segundos) para as requisições HTTP feitas à API externa
TIMEOUT_API_CONN="1"
TIMEOUT_API_READ="1"

# Credenciais usadas pelo docker-compose.yml para provisionar os serviços
# (devem ser consistentes com as URIs acima)
MONGO_ROOT_USERNAME="root"
MONGO_ROOT_PASSWORD="SENHA_AQUI"
RABBITMQ_DEFAULT_USER="admin"
RABBITMQ_DEFAULT_PASS="SENHA_AQUI"
MONGO_EXPRESS_BASICAUTH_USERNAME="admin"
MONGO_EXPRESS_BASICAUTH_PASSWORD="SENHA_AQUI"
